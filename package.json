{
  "name": "fintech",
  "version": "0.1.0",
  "private": true,
  "description": "數位財富管理全端作品集 — React 19 + NestJS + PostgreSQL + Redis",
  "type": "module",
  "//workspaces": [
    "workspaces 只列出「已經有 package.json」的子專案。",
    "npm 找不到對應的 package.json 會直接報錯，所以不能先寫好佔位。",
    "後續單元建立子專案時，記得回來把名字加進下面這個陣列：",
    "（目前四個子專案都已建立，這份清單保留作為紀錄）"
  ],
  "workspaces": [
    "shared",
    "api",
    "web",
    "market-feed"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force && npm run typecheck -w @fintech/api",

    "dev:api": "npm run start:dev -w @fintech/api",
    "dev:web": "npm run dev -w @fintech/web",
    "dev:feed": "npm run start:dev -w @fintech/market-feed",
    "migrate": "npm run migrate -w @fintech/api",
    "seed": "npm run seed -w @fintech/api",

    "up": "docker compose up -d",
    "down": "docker compose down",
    "logs": "docker compose logs -f",
    "db": "docker exec -it fintech-postgres psql -U fintech -d fintech",
    "redis": "docker exec -it fintech-redis redis-cli",
    "health": "curl -s http://localhost:3000/api/v1/health"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "@types/node": "^22.10.0"
  }
}
