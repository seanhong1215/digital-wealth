{
  "$schema": "https://swc.rs/schema.json",

  "jsc": {
    "parser": {
      "syntax": "typescript",
      "decorators": true
    },

    "transform": {
      "legacyDecorators": true,
      "decoratorMetadata": true
    },

    "target": "es2022",
    "keepClassNames": true
  },

  "module": {
    "type": "nodenext"
  }
}
