# ==============================================================================
# .env.example — 環境變數範本
#
# 這個檔案是什麼：
#   列出本專案需要哪些環境變數，以及各自的預設值。
#   它會進版控，讓任何 clone 這個專案的人知道要設定什麼。
#
# 怎麼用：
#   複製一份改名為 .env（`cp .env.example .env`），再依需要修改值。
#   .env 不會進版控（已寫進 .gitignore），因為它可能含有真實密碼。
#
# 為什麼要分兩個檔：
#   .env.example 是「規格」——告訴人有哪些設定項。
#   .env 是「實際值」——可能含機密，不能外流。
#   這是業界標準做法，少了 .env.example，別人 clone 下來會不知道要設什麼。
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------------------------

# 資料庫主機。
#
# ★ 這個值會因為「你從哪裡連」而不同，是新手最常卡住的地方：
#     - 在你的電腦上跑 npm run start:dev  →  localhost（走 port 映射）
#     - 在 Docker 容器內                  →  postgres（Compose 的服務名）
#
#   這裡填 localhost 就好 —— docker-compose.yml 會在容器內
#   直接覆寫成 postgres，不會讀到這個值。
POSTGRES_HOST=localhost

# 資料庫使用者名稱
POSTGRES_USER=fintech

# 資料庫密碼
# 【本機開發用弱密碼沒關係】因為服務只綁在 localhost，不對外開放。
# 若未來要部署到雲端，這裡必須換成強密碼，且不可進版控。
POSTGRES_PASSWORD=fintech_dev_pw

# 資料庫名稱
POSTGRES_DB=fintech

# 映射到「主機」的 port，也就是你用 psql 連線時要打的 port。
# 容器內部固定是 5432，不受這個值影響。
# 如果你的電腦上已經有其他 PostgreSQL 佔用 5432，改成 15432 之類的即可。
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Redis
# ------------------------------------------------------------------------------

# Redis 主機。同 POSTGRES_HOST 的說明：本機用 localhost，容器內用 redis。
REDIS_HOST=localhost

# 映射到「主機」的 port。容器內部固定是 6379。
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# API（單元 0.6 起啟用）
# ------------------------------------------------------------------------------

# API 服務的 port。
# 容器內固定 3000，這個值只影響映射到你電腦上的 port。
API_PORT=3000

# 執行環境。development / production。
# 影響：日誌詳細程度、Demo 控制台是否掛載（Phase 4）、
#       錯誤回應是否含 stack trace。
NODE_ENV=development

# ------------------------------------------------------------------------------
# 以下為後續單元會用到，目前尚未啟用
# ------------------------------------------------------------------------------

# 前端開發伺服器的 port（Phase 1 啟用）
# 注意：目前這台機器的 5173 已被其他程式佔用，屆時可能要改 5174
# WEB_PORT=5173

# ------------------------------------------------------------------------------
# 認證（單元 1.1 起啟用）
# ------------------------------------------------------------------------------

# JWT 簽章密鑰 ★ 本專案最敏感的設定
#
# 這把密鑰決定「誰能簽出有效的 token」。任何人拿到它就能偽造出
# 任意身分的 token —— 整套認證直接失效。
#
# 【必須自己產生一組，不要沿用任何範例值】
#   產生方式：openssl rand -base64 32
#
# 沒有預設值是刻意的 —— 沒設定的話服務會直接啟動失敗，
# 而不是靜默地用一把大家都知道的密鑰在跑。
JWT_SECRET=

# Demo 控制台開關（Phase 4 啟用）
# 設為 1 時才會掛載 /api/v1/demo/* 路由
# ENABLE_DEMO=1
